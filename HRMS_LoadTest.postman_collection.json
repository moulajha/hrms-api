		{
			"name": "Organizations",
			"item": [
				{
					"name": "Create Organization",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Organization creation successful\", function() {",
									"    pm.response.to.have.status(201);",
									"    ",
									"    if (pm.response.code === 201) {",
									"        try {",
									"            const jsonData = pm.response.json();",
									"            const organization = jsonData.data;",
									"            ",
									"            // Store organization ID for subsequent requests",
									"            if (!pm.environment.get(\"organizationIds\")) {",
									"                pm.environment.set(\"organizationIds\", JSON.stringify([organization.id]));",
									"            } else {",
									"                const ids = JSON.parse(pm.environment.get(\"organizationIds\"));",
									"                ids.push(organization.id);",
									"                pm.environment.set(\"organizationIds\", JSON.stringify(ids));",
									"            }",
									"            ",
									"            // Verify organization data structure",
									"            pm.test(\"Response has required organization data\", () => {",
									"                pm.expect(organization).to.have.property('id');",
									"                pm.expect(organization).to.have.property('name');",
									"                pm.expect(organization).to.have.property('slug');",
									"                pm.expect(organization).to.have.property('email');",
									"            });",
									"            ",
									"            // Log success",
									"            console.log(\"Organization created:\", {",
									"                id: organization.id,",
									"                name: organization.name,",
									"                slug: organization.slug",
									"            });",
									"        } catch (error) {",
									"            console.error(\"Error processing response:\", error);",
									"            throw error;",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
