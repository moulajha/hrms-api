	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Sign In",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Successful sign-in and role verification\", function() {",
									"    pm.response.to.have.status(200);",
									"    ",
									"    if (pm.response.code === 200) {",
									"        try {",
									"            const jsonData = pm.response.json();",
									"            const user = jsonData.user;",
									"            const session = jsonData.session;",
									"            ",
									"            // Set auth and user info",
									"            pm.environment.set(\"accessToken\", session.access_token);",
									"            pm.environment.set(\"organizationId\", user.profile.organization.id);",
									"            ",
									"            // Set and verify roles",
									"            const roles = user.roles;",
									"            pm.environment.set(\"userRoles\", roles);",
									"            ",
									"            // Log current roles for debugging",
									"            console.log(\"Current user roles:\", roles);",
									"            ",
									"            // Verify if user has required roles (ADMIN or HR_MANAGER)",
									"            const hasRequiredRole = roles.some(role => ",
									"                role === 'ADMIN' || role === 'HR_MANAGER' || role === 'SUPER_ADMIN'",
									"            );",
									"            ",
									"            pm.test(\"User has required role for employee creation\", () => {",
									"                pm.expect(hasRequiredRole).to.be.true;",
									"            });",
									"            ",
									"            // Verify response structure",
									"            pm.test(\"Response has required user data\", () => {",
									"                pm.expect(user).to.have.property('id');",
									"                pm.expect(user).to.have.property('email');",
									"                pm.expect(user).to.have.property('profile').that.is.an('object');",
									"                pm.expect(user.profile).to.have.property('organization').that.is.an('object');",
									"                pm.expect(user).to.have.property('roles').that.is.an('array');",
									"                pm.expect(user).to.have.property('permissions').that.is.an('array');",
									"                pm.expect(session).to.have.property('access_token');",
									"            });",
									"            ",
									"            // Log all set variables",
									"            console.log(\"Set variables:\", {",
									"                accessToken: session.access_token,",
									"                organizationId: user.profile.organization.id,",
									"                roles: roles",
									"            });",
									"        } catch (error) {",
									"            console.error(\"Error processing response:\", error);",
									"            throw error;",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/signin",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"signin"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Get current user successful\", function() {",
									"    pm.response.to.have.status(200);",
									"    ",
									"    if (pm.response.code === 200) {",
									"        try {",
									"            const user = pm.response.json();",
									"            ",
									"            // Verify user data structure",
									"            pm.test(\"Response has required user data\", () => {",
									"                pm.expect(user).to.have.property('id');",
									"                pm.expect(user).to.have.property('email');",
									"                pm.expect(user).to.have.property('profile').that.is.an('object');",
									"                pm.expect(user.profile).to.have.property('organization').that.is.an('object');",
									"                pm.expect(user).to.have.property('roles').that.is.an('array');",
									"                pm.expect(user).to.have.property('permissions').that.is.an('array');",
									"            });",
									"            ",
									"            // Log user info",
									"            console.log(\"Current user info:\", {",
									"                id: user.id,",
									"                email: user.email,",
									"                organizationId: user.profile.organization.id,",
									"                roles: user.roles",
									"            });",
									"        } catch (error) {",
									"            console.error(\"Error processing response:\", error);",
									"            throw error;",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
